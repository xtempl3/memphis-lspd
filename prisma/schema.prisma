generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }
enum Role { OFFICER SUPERVISOR COMMAND ADMIN }
enum Status { PENDING APPROVED REJECTED CHANGES_REQUESTED }
model Department { id String @id @default(cuid())
  code String @unique
  name String
  users User[] }
model User { id String @id @default(cuid())
  discordId String @unique
  username String
  avatar String?
  role Role @default(OFFICER)
  rank String @default("Officer I")
  rankSince DateTime @default(now())
  badge String?
  departmentId String?
  department Department? @relation(fields:[departmentId], references:[id])
  applications Application[] @relation("author")
  reviewed Application[] @relation("reviewer")
  notifications Notification[]
  createdAt DateTime @default(now()) }
model Application { id String @id @default(cuid())
  type String
  data Json
  files String[]
  status Status @default(PENDING)
  comment String?
  authorId String
  author User @relation("author", fields:[authorId], references:[id])
  reviewerId String?
  reviewer User? @relation("reviewer", fields:[reviewerId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history HistoryEntry[] }
model HistoryEntry { id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete: Cascade)
  actorId String
  action String
  comment String?
  createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  text String
  read Boolean @default(false)
  createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid())
  actorId String
  action String
  createdAt DateTime @default(now()) }
